# Copy to .env on the production host and replace every CHANGE_ME value.
# Keep this file out of public logs and backups unless encrypted by the backup runbook.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
FRONTEND_URL=https://intly.tech

MONGO_ROOT_USER=intly
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MONGO_ROOT_PASSWORD
MONGODB_URI=mongodb://intly:CHANGE_ME_LONG_RANDOM_MONGO_ROOT_PASSWORD@mongo:27017/intly?authSource=admin
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD@redis:6379

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MASTER_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
WORKER_CONCURRENCY=4
QUEUE_BACKPRESSURE_LIMIT=1000
SOURCE_SCHEDULER_ENABLED=true

MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_LONG_RANDOM_MEILI_MASTER_KEY
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_MINIO_SECRET_KEY
MINIO_BUCKET=intly-private
MINIO_IMAGE=ghcr.io/OWNER/intly-backend/minio:COMMIT_SHA

INTLY_BACKEND_IMAGE=ghcr.io/OWNER/intly-backend:COMMIT_SHA
# Full production topology starts managed Firecrawl and local embedding sidecars.
# Set COMPOSE_PROFILES= and point FIRECRAWL_API_URL/EMBEDDING_BASE_URL to external endpoints to disable them.
COMPOSE_PROFILES=firecrawl,embedding
INTLY_COMPOSE_WAIT_TIMEOUT_SECONDS=600
INTLY_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
TESSERACT_LANG_PATH=/app/tessdata
TESSERACT_CACHE_PATH=/tmp/tesseract-cache

FIRECRAWL_API_URL=http://firecrawl-api:3002
FIRECRAWL_IMAGE=ghcr.io/firecrawl/firecrawl@sha256:2b5ca4e5b1a0a4c092ff15b874fa1a6a3d9af5aaa7efb13142f7ca38eea1ff6b
FIRECRAWL_PLAYWRIGHT_IMAGE=ghcr.io/firecrawl/playwright-service@sha256:47da52c036b55580d5d0812fa530eacfe03533ebad9449a50858ff697db04f71
FIRECRAWL_NUQ_POSTGRES_IMAGE=ghcr.io/firecrawl/nuq-postgres@sha256:9b638af78d99873bc0ba2b57c9cbcd01df6ce96efeaa72d36cfbe0f76521e8fc
FIRECRAWL_EXTRACT_WORKER_PORT=3004
FIRECRAWL_WORKER_PORT=3005
FIRECRAWL_POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_FIRECRAWL_POSTGRES_PASSWORD

# Use ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9 on ARM64 hosts.
EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
EMBEDDING_BASE_URL=http://embedding:80
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MAX_BATCH_TOKENS=2048
EMBEDDING_MAX_BATCH_REQUESTS=4
EMBEDDING_MAX_CONCURRENT_REQUESTS=8
EMBEDDING_TOKENIZATION_WORKERS=2

RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
EMAIL_FROM=INTLY <noreply@intly.tech>
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=CHANGE_ME_GOOGLE_API_KEY
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
TELEGRAM_API_ID=CHANGE_ME_TELEGRAM_API_ID
TELEGRAM_API_HASH=CHANGE_ME_TELEGRAM_API_HASH
TELEGRAM_SESSION=CHANGE_ME_TELEGRAM_SESSION
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
OUTBOUND_PROXY_URL=
LOG_LEVEL=info
